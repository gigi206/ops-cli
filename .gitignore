# Rust build output. The exec shim (`proc-shim/`) is its own crate with its own target dir;
# sbx's build script builds it under OUT_DIR, but a manual build there lands here.
/target
/proc-shim/target

# Backup files created manually (never commit)
*.bak
*.bak-*

# Per-contributor mise overlay. Lets you add local-only settings on top of the
# shared `mise.toml` without touching the committed file. Read automatically by mise.
mise.local.toml
.mise.local.toml

# Local flake experiments (never committed); contributors who want to try one
# locally drop flake.nix/flake.lock here and they stay untracked.
flake.nix
flake.lock

# Environment / secrets (never committed)
.env
.env.*
!.env.example

# Editor / IDE noise
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local AI-tool project dir (symlinks into $HOME; never committed)
.antigravitycli/

# Mise-managed Python virtualenv (docs tooling; never commit)
.venv/

# MkDocs build output (docs site; regenerated by `mise run docs-build`)
/site/

# Freebuff Desktop local checkout artifacts (sqlite db + wal/shm; regenerated by
# the desktop client). Keep this repo clean of the editor's working state.
.freebuff/
