# syntax=docker/dockerfile:1.6
#
# CI smoke Dockerfile. Single source of truth — referenced by:
#   - .github/workflows/tests.yml (runtime-build matrix job)
#   - mise.toml (tasks.smoke)
# Both used to here-doc this file inline; the duplication had drifted
# more than once. Keep this fixture minimal: alpine + a non-root user,
# enough to exercise the full ops.sh build pipeline (flags, lock file,
# hash, labels) without pulling the full Nix tree.
FROM docker.io/library/alpine:3.19
ARG USER_UID=1000
ARG USER_GID=1000
ARG USER_NAME=ci
ARG USER_LANG=C
RUN addgroup -g "$USER_GID" "$USER_NAME" \
 && adduser -D -u "$USER_UID" -G "$USER_NAME" "$USER_NAME"
USER ${USER_NAME}
CMD ["sh"]
