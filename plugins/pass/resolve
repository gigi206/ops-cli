#!/usr/bin/env bash
# sbx resolver plugin: pass(1) password store.
# Contract: sbx passes the full ref as $1; print the plaintext to stdout; exit 0 on success.
#   Ref:  pass://<path>   e.g.  pass://github/token   (returns the first line — the password)
set -euo pipefail

ref="${1:?pass: missing secret ref}"
path="${ref#pass://}"
[ "$path" != "$ref" ] || { echo "pass: ref must start with pass:// ('$ref')" >&2; exit 1; }
[ -n "$path" ] || { echo "pass: empty path in '$ref'" >&2; exit 1; }

shopt -s nullglob

# The sandbox sets HOME to a private tmpfs, but pass(1) derives the store from it and GnuPG
# derives both the keyring and the agent socket directory from it — under the tmpfs HOME all
# three point at paths that do not exist here, and gpg then tries to start an agent of its own
# against a read-only mount. Restore the host home the manifest bound: it is the only one in
# the cage, so a glob identifies it without needing to know the user's name (there is no
# /etc/passwd here either).
for d in /home/*/.password-store /var/home/*/.password-store \
         /home/*/.gnupg /var/home/*/.gnupg; do
    [ -d "$d" ] && { HOME="${d%/*}"; export HOME; break; }
done
[ "$HOME" != "/tmp" ] || {
    echo "pass: neither a password store nor a GnuPG home is in the plugin sandbox: check \
allow_paths in plugin.toml, and if your home is outside /home add its parent to the search \
in this script" >&2
    exit 1
}

# The cage's PATH is /usr/bin:/bin, so a user-mode install of pass(1) is not on it.
for dir in /usr/bin "$HOME/.nix-profile/bin" /home/linuxbrew/.linuxbrew/bin \
           /opt/homebrew/bin "$HOME/.local/bin" /nix/var/nix/profiles/default/bin; do
    [ -x "$dir/pass" ] && { PASS="$dir/pass"; break; }
done
[ -n "${PASS:-}" ] || {
    echo "pass: the pass(1) binary is not in the plugin sandbox — add its directory (and \
/nix/store for a nix profile) to allow_paths in plugin.toml" >&2
    exit 1
}

# An entry this store does not hold is a clean absent (exit 0, nothing on stdout), so the
# caller falls through to the next source in a `from` chain. It is settled before pass(1)
# runs, which keeps every remaining failure — a broken keyring, an unreachable agent — a hard
# error instead of being read as "not held here". A store that is missing altogether is a
# configuration problem rather than an absent, and is refused above.
store="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
[ -f "$store/$path.gpg" ] || {
    echo "pass: '$path' is not in the password store" >&2
    exit 0
}

# pass(1) prints the whole entry; the first line is the secret by convention.
"$PASS" show "$path" | head -n1
