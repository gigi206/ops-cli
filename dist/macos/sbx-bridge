#!/bin/sh
# sbx on a Mac: the Mac's half of the two channels a Lima guest shares with it.
#
# Run by launchd, never by hand. The guest cannot run a program on the Mac, so what it needs from
# the Mac reaches it through two directories the template mounts into the guest at paths no cage
# is given:
#
#   theme    this script writes `dark` or `light` into `color-scheme`, which the guest reads to
#            open and keep a caged app in the Mac's appearance. The guest mounts it read-only.
#   notify   sbx in the guest drops one file per note into `queue/`, its own refusals and what a
#            caged app raises through its relay; this script raises each one in Notification
#            Center and removes it. The guest mounts it writable.
#
# `notify/queue` is the guest's to write, so nothing found there is trusted. Each entry is first
# renamed into a directory of the Mac's own, outside every mount, so the guest can no longer swap
# it for a link or a FIFO between the check and the read; only then is it checked. Only a regular
# file with a name of the shape sbx gives is read, only its first bytes, with control characters
# taken out and the other line separators made spaces, and its three lines reach Notification
# Center as data rather than as script text.
# Every other entry is removed unread, because launchd starts this script again for as long as the
# directory it watches is not empty.
#
# A note is raised under the sbx application the installer builds beside this script, so it shows
# sbx's name and icon: the checked lines are written into a hand-off directory of the Mac's own and
# the application is asked to open them. Without that application, or when it cannot be opened,
# the note is raised through `osascript`, under Script Editor's icon.

set -eu

: "${SBX_BRIDGE_DIR:=$HOME/.local/state/sbx/lima}"

# How many notes of each source one run raises: sbx's refusals (`sbx-*`) and a caged app's
# notifications (`app-*`) have a ceiling each, as they have a share of the queue each, so a busy app
# never crowds out a refusal. The rest of a burst is removed rather than raised, so a cage refusing
# or notifying in a loop cannot fill Notification Center.
MAX_RAISED=5

# The line and paragraph separators past the control range, NEL, LS and PS, which a renderer may
# break a line on. Built from their UTF-8 bytes, so the substitution below is byte for byte.
NEL=$(printf '\302\205')
LS=$(printf '\342\200\250')
PS=$(printf '\342\200\251')

# The application notes are raised under, built by the installer next to this script.
NOTIFIER="${0%/*}/sbx.app"

# Raise one note through `osascript`, the title, subtitle and body passed as arguments, each behind
# a leading `x` the script strips. `osascript` reads options for as long as the arguments before are
# options, and each `-e` here is one, so a field starting with `-` would be read as another: a
# title of `-e` would make the subtitle a line of the script, run on the Mac. The mark keeps every
# field an argument, whatever it starts with and however `osascript` parses.
raise_with_osascript() {
  /usr/bin/osascript \
    -e 'on unmark(s)' \
    -e 'if (count of s) < 2 then return ""' \
    -e 'return text 2 thru -1 of s' \
    -e 'end unmark' \
    -e 'on run argv' \
    -e 'display notification (my unmark(item 3 of argv)) with title (my unmark(item 1 of argv)) subtitle (my unmark(item 2 of argv))' \
    -e 'end run' \
    "x$1" "x$2" "x$3" >/dev/null 2>&1 || true
}

# Raise the note in the hand-off file $1 through `osascript`, then remove the file.
raise_file_with_osascript() {
  raise_with_osascript "$(sed -n 1p "$1")" "$(sed -n 2p "$1")" "$(sed -n 3p "$1")"
  rm -f -- "$1"
}

theme() {
  dir="$SBX_BRIDGE_DIR/theme"
  mkdir -p "$dir"
  # `AppleInterfaceStyle` holds the appearance in effect, in Auto mode as well; it is absent in
  # Light.
  if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)" = Dark ]; then
    word=dark
  else
    word=light
  fi
  # Written only on a change, through a temporary name, so the guest never reads half a word.
  if [ "$(cat "$dir/color-scheme" 2>/dev/null || true)" != "$word" ]; then
    printf '%s\n' "$word" > "$dir/.color-scheme.new"
    mv -f "$dir/.color-scheme.new" "$dir/color-scheme"
  fi
}

notify() {
  queue="$SBX_BRIDGE_DIR/notify/queue"
  work="$SBX_BRIDGE_DIR/notify-work"
  handoff="$SBX_BRIDGE_DIR/notify-raise"
  [ -d "$queue" ] || exit 0
  # The same filesystem as the queue, so the rename below is atomic, and mounted nowhere.
  mkdir -p "$work" "$handoff"
  chmod 0700 "$work" "$handoff"
  # A hand-off the application never opened, because it was not allowed to run or the Mac slept
  # through it, would otherwise stay.
  find "$handoff" -type f -mmin +10 -exec rm -f {} + 2>/dev/null || true
  raised_sbx=0
  raised_app=0
  set --
  for entry in "$queue"/* "$queue"/.[!.]* "$queue"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name=${entry##*/}
    held="$work/$name"
    rm -rf -- "$held"
    mv -f -- "$entry" "$held" 2>/dev/null || { rm -rf -- "$entry"; continue; }
    entry=$held
    case "$name" in
      *[!A-Za-z0-9._-]* | .*) ok=no ;;
      *.note) ok=yes ;;
      *) ok=no ;;
    esac
    # A note from before the names carried their source is sbx's own: nothing else wrote one.
    case "$name" in
      app-*) raised=$raised_app ;;
      *) raised=$raised_sbx ;;
    esac
    if [ "$ok" = yes ] && [ -f "$entry" ] && [ ! -L "$entry" ] && [ "$raised" -lt "$MAX_RAISED" ]; then
      text=$(head -c 2048 "$entry" | LC_ALL=C tr -d '\000-\011\013-\037\177' |
        LC_ALL=C sed -e "s/$NEL/ /g" -e "s/$LS/ /g" -e "s/$PS/ /g")
      title=$(printf '%s\n' "$text" | sed -n 1p)
      subtitle=$(printf '%s\n' "$text" | sed -n 2p)
      body=$(printf '%s\n' "$text" | sed -n 3p)
      if [ -n "$title" ]; then
        if [ -d "$NOTIFIER" ]; then
          printf '%s\n%s\n%s\n' "$title" "$subtitle" "$body" > "$handoff/$name.sbxnote"
          set -- "$@" "$handoff/$name.sbxnote"
        else
          raise_with_osascript "$title" "$subtitle" "$body"
        fi
        case "$name" in
          app-*) raised_app=$((raised_app + 1)) ;;
          *) raised_sbx=$((raised_sbx + 1)) ;;
        esac
      fi
    fi
    rm -rf -- "$entry"
  done
  # One launch of the application for the whole run; it removes each file once raised. `open`
  # returns before the notes are raised, so a failure here is one to launch it at all, and those
  # notes are raised the other way.
  if [ "$#" -gt 0 ] && ! /usr/bin/open -g -a "$NOTIFIER" "$@" >/dev/null 2>&1; then
    for file in "$@"; do
      raise_file_with_osascript "$file"
    done
  fi
}

case "${1:-}" in
  theme) theme ;;
  notify) notify ;;
  *)
    printf 'usage: %s theme|notify\n' "${0##*/}" >&2
    exit 2
    ;;
esac
